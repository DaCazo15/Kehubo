{
  "name": "compara-cartas",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n \"VITE,SERVER,TEST\" -c \"cyan,magenta,green\" \"npm run dev\" \"npm run server\" \"npm run test:watch\"",
    "start": "npm run dev:all",
    "type-check": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "animejs": "^4.5.0",
    "bootstrap-icons": "^1.13.1",
    "cors": "^2.8.6",
    "country-flag-icons": "^1.6.20",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.18.0",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "multer": "^2.3.0",
    "pinia": "^4.0.3",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.24",
    "vue-router": "^5.3.1",
    "vuefire": "^3.2.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.5.0",
    "concurrently": "^10.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.4",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  }
}
