rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Reglas para la colección de usuarios y sus subcolecciones
    match /users/{userId} {
      // Cualquier usuario puede leer perfiles públicos
      allow read: if true;
      // Sólo el usuario dueño puede crear o modificar su propio perfil
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if request.auth != null && request.auth.uid == userId;

      // Subcolección de amigos
      match /friends/{friendId} {
        // Cualquier usuario autenticado o visitante puede ver la lista de amigos
        allow read: if true;
        // Sólo usuarios autenticados pueden gestionar amistades
        allow write: if request.auth != null;
      }
    }

    // Reglas para la colección de puntuaciones (scores)
    match /scores/{scoreId} {
      // Todos pueden leer el ranking y puntuaciones
      allow read: if true;
      // Sólo usuarios autenticados pueden guardar sus propias partidas
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      // Sólo el autor puede modificar/eliminar su registro
      allow update, delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    // Reglas para la colección de notificaciones
    match /notifications/{notificationId} {
      // El usuario destinatario o remitente puede leer sus notificaciones
      allow read: if request.auth != null;
      // Cualquier usuario autenticado puede emitir notificaciones a otros
      allow create: if request.auth != null;
      // El destinatario o participantes pueden actualizar (marcar leída, aceptar/rechazar) o eliminar
      allow update, delete: if request.auth != null;
    }

    // Reglas para salas competitivas multijugador (rooms)
    match /rooms/{roomId} {
      // Cualquier participante puede leer la sala
      allow read: if true;
      // Crear sala con validación de estructura requerida
      allow create: if request.resource.data.code is string
                    && request.resource.data.hostId is string
                    && request.resource.data.status == 'waiting'
                    && request.resource.data.maxPlayers <= 4
                    && request.resource.data.config != null;
      // Solo el anfitrión o actualización legítima de estado
      allow update: if (request.auth != null && request.auth.uid == resource.data.hostId)
                    || (request.resource.data.hostId == resource.data.hostId);
      allow delete: if request.auth != null && request.auth.uid == resource.data.hostId;

      // 🛡️ SUBCOLECCIÓN SECRETA (Valores reales del mazo en servidor):
      // Bloqueada para cualquier cliente directo. Solo accesible por Firebase Admin SDK en Cloud Functions.
      match /secret/{secretDoc} {
        allow read, write: if false;
      }

      // Subcolección de jugadores en la sala
      match /players/{playerId} {
        allow read: if true;
        // Registro inicial del jugador con valores iniciales limpios
        allow create: if request.resource.data.uid == playerId
                      && request.resource.data.score == 0
                      && request.resource.data.pairsFound == 0;
        // Actualización de progreso: solo el propio jugador y acotado matemáticamente
        allow update: if ((request.auth != null && request.auth.uid == playerId) || request.resource.data.uid == playerId)
                      && request.resource.data.score >= resource.data.score
                      && request.resource.data.pairsFound >= resource.data.pairsFound
                      && request.resource.data.pairsFound <= get(/databases/$(database)/documents/rooms/$(roomId)).data.config.cardCount / 2;
        allow delete: if (request.auth != null && request.auth.uid == playerId)
                      || (request.auth != null && request.auth.uid == get(/databases/$(database)/documents/rooms/$(roomId)).data.hostId);
      }
    }

    // Regla por defecto para otras colecciones (si las hubiera)
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
